rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function shopee(u) {
      return u is string && u.matches('^https://([a-z0-9-]+\\.)*(shopee\\.[a-z.]+|shope\\.ee|shp\\.ee)(/.*)?$');
    }
    function tiktok(u) {
      return u is string && u.matches('^https://([a-z0-9-]+\\.)*(tiktok\\.com|tiktokshop\\.com|tokopedia\\.com|tokopedia\\.link)(/.*)?$');
    }
    function okLinks(d) {
      let s = d.get('affiliateUrl', '');
      let t = d.get('tiktokUrl', '');
      return (s == '' || shopee(s)) && (t == '' || tiktok(t)) && (s != '' || t != '');
    }
    // Statistik anonim: pengunjung hanya boleh menambah penghitung maksimal +1 per tulis, tidak boleh membaca.
    function inc(f) {
      return request.resource.data.get(f, 0) is int
        && request.resource.data.get(f, 0) >= 0
        && request.resource.data.get(f, 0) - (resource == null ? 0 : resource.data.get(f, 0)) <= 1;
    }
    match /owners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isOwner();
      allow create, update: if isOwner()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.get('images', []).size() <= 5
        && okLinks(request.resource.data);
      allow delete: if isOwner();
    }
    match /banners/{id} {
      allow read: if resource.data.active == true || isOwner();
      allow write: if isOwner();
    }
    match /categories/{id} { allow read: if true; allow write: if isOwner(); }
    match /settings/{id} { allow read: if true; allow write: if isOwner(); }
    match /stats_daily/{d} {
      allow read: if isOwner();
      allow create, update: if d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == d
        && request.resource.data.keys().hasOnly(['date', 'views', 'visitors', 'clicks'])
        && inc('views') && inc('visitors') && inc('clicks');
    }
    match /product_daily/{d} {
      allow read: if isOwner();
      allow create, update: if d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[A-Za-z0-9]+$')
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && d == request.resource.data.date + '_' + request.resource.data.pid
        && request.resource.data.keys().hasOnly(['date', 'pid', 'views', 'clicksShopee', 'clicksTiktok'])
        && inc('views') && inc('clicksShopee') && inc('clicksTiktok');
    }
  }
}
